# Copy to .env; never commit the filled-in file.
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=sqlite:///./data/factory.db
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_ORIGIN=http://localhost:8000
PUBLIC_URL=http://localhost:3000
MEDIA_ROOT=./data/media

# Local, manual FFmpeg workflow. No paid API calls; keep true for no-service-fee use.
FREE_MODE=true

# Native AUTO CREATE uses only a loopback Ollama server, never hosted inference.
LOCAL_AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_MAX_RETRIES=1
LOCAL_AI_MAX_FRAMES=12
LOCAL_AI_FRAME_BATCH_SIZE=1
LOCAL_AI_SCENE_TIMEOUT_SECONDS=600
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_CPU_THREADS=4
# Enable only during explicit setup/first model download; inference stays local.
LOCAL_AI_ALLOW_MODEL_DOWNLOAD=false

# Optional hosted AI, disabled by FREE_MODE=true even if a key is present.
# Enabling FREE_MODE=false can incur provider charges; not needed for local rendering.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
AI_VISION_ENABLED=true
AI_HTTP_TIMEOUT_SECONDS=180
AI_MAX_INPUT_CHARACTERS=160000
AI_MAX_OUTPUT_TOKENS=8000
MAX_SOURCE_DURATION_SECONDS=3600

# FFmpeg renders real video on the local CPU; imageio-ffmpeg supplies a Windows fallback.
# Leave empty to use PATH/fallback. Docker installs FFmpeg and ffprobe.
FFMPEG_BINARY=
FFPROBE_BINARY=

# Dormant hosted-operation limits. Zero monthly allowance blocks paid jobs too.
# Local manual jobs do not reserve paid-provider costs.
MONTHLY_SPEND_LIMIT_USD=0
MAX_JOB_COST_USD=2
MAX_UPLOAD_MB=500
RETENTION_DAYS=30

# Optional S3-compatible storage; external storage is disabled in free mode.
# Keep the bucket blank for local disk storage.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional official social connections, independent of free local inference.
# Leave disabled until you configure developer credentials and intend to connect.
SOCIAL_INTEGRATIONS_ENABLED=false
# Manual publishing packages do not need these credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/accounts/youtube/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Web Login requires a registered static HTTPS callback.
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.list
# Set true only after the application's actual official Direct Post audit.
TIKTOK_DIRECT_POST_AUDITED=false

# Optional free public-data research; no hosted inference. Missing key continues locally.
YOUTUBE_DATA_API_KEY=
YOUTUBE_RESEARCH_DAILY_REQUEST_LIMIT=20
