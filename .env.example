# Copy to .env; never commit the filled-in file.
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=sqlite:///./data/factory.db
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_ORIGIN=http://localhost:8000
PUBLIC_URL=http://localhost:3000
MEDIA_ROOT=./data/media

# Hosted AI. Missing credentials block AI generation with an actionable error.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
AI_VISION_ENABLED=true
AI_HTTP_TIMEOUT_SECONDS=180
AI_MAX_INPUT_CHARACTERS=160000
AI_MAX_OUTPUT_TOKENS=8000
MAX_SOURCE_DURATION_SECONDS=3600

# FFmpeg and ffprobe must be installed for real rendering.
# Leave empty when they are on PATH; Docker installs both.
FFMPEG_BINARY=
FFPROBE_BINARY=

# Conservative limits; provider usage and billing should also be capped externally.
MONTHLY_SPEND_LIMIT_USD=25
MAX_JOB_COST_USD=2
MAX_UPLOAD_MB=500
RETENTION_DAYS=30

# Optional S3-compatible storage. Empty bucket selects local disk storage.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Official YouTube OAuth. Create a Web application OAuth client in Google Cloud.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/accounts/youtube/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
